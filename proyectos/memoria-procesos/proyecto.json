{
  "nombre": "memoria-procesos",
  "estado": "en-construccion",
  "temas": [
    "latex",
    "memoria",
    "tikz",
    "pgfplots"
  ],
  "necesita": [
    "latex"
  ],
  "apt": [
    "fonts-crosextra-carlito",
    "poppler-utils"
  ],
  "repos": {
    "saas": "https://github.com/VelaElDios/la-grada-colchonera-saas"
  },
  "fuentes": [
    "repo:saas/docs/*.md",
    "repo:saas/CONTRIBUTING.md",
    "repo:saas/@arbol",
    "repo:saas/memoria/bibliografia.bib",
    "repo:saas/memoria/main.tex",
    "repo:saas/memoria/capitulos/*.tex",
    "repo:saas/memoria/anexos/*.tex",
    "fuentes/estructura-memoria.md",
    "fuentes/uso-ia.md",
    "fuentes/bibliografia-extra.md"
  ],
  "copiar": [
    {
      "desde": "repo:saas/docs/capturas/**/*.png",
      "a": "figs/capturas"
    }
  ],
  "protegidos": [
    "Memoria.tex",
    "latexmkrc",
    "include/configuracion.tex",
    "include/colores.tex",
    "include/extra.tex",
    "include/opciones.tex",
    "elements/portada.tex",
    "figs/*"
  ],
  "archivo_principal": "Memoria.tex",
  "comando_prueba": "rm -f Memoria.log Memoria.pdf && python3 ../revisar_umlsd.py && latexmk -g -lualatex -interaction=nonstopmode -halt-on-error -file-line-error Memoria.tex && { python3 ../verificar.py; a=$?; python3 ../../../scripts/revisar_maquetacion.py Memoria.pdf; b=$?; python3 ../../../scripts/revisar_figuras.py Memoria.pdf; c=$?; [ $a -eq 0 ] && [ $b -eq 0 ] && [ $c -eq 0 ]; }",
  "reintentar_si": "^(!|\\S+\\.(tex|sty|cls|bib):\\d+:)|Fatal error|Emergency stop|Todavía no existe",
  "max_archivos_por_paso": 2,
  "pasos": 128,
  "max_pasos": 150,
  "max_intentos": 3,
  "ultima_ejecucion": "2026-11-25T01:10:18+01:00",
  "reglas": [
    "memoria/reglas-tfg.md"
  ]
}
