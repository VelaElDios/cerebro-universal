{
  "nombre": "memoria-procesos",
  "estado": "pausado",
  "temas": [
    "latex",
    "memoria",
    "tikz",
    "pgfplots"
  ],
  "necesita": [
    "latex"
  ],
  "apt": [
    "fonts-crosextra-carlito"
  ],
  "repos": {
    "saas": "https://github.com/VelaElDios/la-grada-colchonera-saas"
  },
  "fuentes": [
    "repo:saas/docs/documentacion-tecnica.md",
    "repo:saas/docs/gestion/README.md",
    "repo:saas/docs/revision-entrega.md",
    "repo:saas/docs/hito4-configuracion.md",
    "repo:saas/CONTRIBUTING.md",
    "repo:saas/@arbol",
    "repo:saas/memoria/bibliografia.bib",
    "fuentes/estructura-memoria.md",
    "fuentes/uso-ia.md"
  ],
  "copiar": [
    {
      "desde": "repo:saas/docs/capturas/**/*.png",
      "a": "figs/capturas"
    }
  ],
  "protegidos": [
    "Memoria.tex",
    "latexmkrc",
    "include/configuracion.tex",
    "include/colores.tex",
    "elements/portada.tex",
    "figs/*"
  ],
  "archivo_principal": "Memoria.tex",
  "comando_prueba": "rm -f Memoria.log Memoria.pdf && latexmk -g -lualatex -interaction=nonstopmode -halt-on-error -file-line-error Memoria.tex && python3 ../verificar.py",
  "reintentar_si": "^(!|\\S+\\.(tex|sty|cls|bib):\\d+:)|Fatal error|Emergency stop|Todavía no existe",
  "max_archivos_por_paso": 3,
  "pasos": 18,
  "max_pasos": 32,
  "max_intentos": 3,
  "ultima_ejecucion": "2026-10-13T22:18:19+02:00"
}
